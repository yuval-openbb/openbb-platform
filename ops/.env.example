# Names only. Real values live in ~/.openbb_platform/.env (mode 600), never in any repo.
# openbb-api basic auth (E3)
OPENBB_API_AUTH=true
OPENBB_API_USERNAME=
OPENBB_API_PASSWORD=
# Research backend API key (E5)
RESEARCH_BACKEND_API_KEY=
# Data providers (FMP/FRED keys live in ~/.openbb_platform/user_settings.json)
FINNHUB_API_KEY=
# Optional email for daily_brief.py
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
BRIEF_TO=
